<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>لعبة لودو مصغرة</title>
    <style>
        body { background: #2c3e50; color: white; text-align: center; font-family: sans-serif; }
        .board { display: grid; grid-template-columns: repeat(3, 100px); gap: 5px; justify-content: center; margin-top: 20px; }
        .cell { width: 100px; height: 100px; background: #34495e; display: flex; align-items: center; justify-content: center; border-radius: 10px; font-size: 40px; }
        .dice { margin: 20px; padding: 20px; font-size: 30px; background: #e74c3c; border-radius: 50px; cursor: pointer; }
    </style>
</head>
<body>
    <h1>لعبة لودو (نسخة تجريبية)</h1>
    <div class="dice" onclick="rollDice()">رمي النرد: <span id="diceVal">0</span></div>
    <div class="board" id="board">
        <!-- المربعات -->
        <div class="cell" id="cell-0">🏠</div>
        <div class="cell" id="cell-1"></div>
        <div class="cell" id="cell-2"></div>
        <div class="cell" id="cell-3"></div>
        <div class="cell" id="cell-4"></div>
        <div class="cell" id="cell-5">🏁</div>
    </div>

    <script>
        function rollDice() {
            const val = Math.floor(Math.random() * 6) + 1;
            document.getElementById('diceVal').innerText = val;
            alert("لقد حصلت على رقم: " + val);
        }
    </script>
</body>
</html>
